# ============================================================================
# BANTUG UNIVERSITY - Student Portal System
# Environment & Email (SMTP) Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env' in the project root:
#      cp .env.example .env
# 2. Update the SMTP parameters with your university or test email server credentials.
# 3. For Gmail, generate an App Password from Google Account Security settings.
# 4. If credentials are not set, the portal runs in safe unconfigured mode,
#    recording all notification attempts to MySQL audit_logs and notification_logs.
# ============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration (XAMPP MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bantug_university_db

# Email / SMTP Service Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admissions@bantug.edu.example
SMTP_PASS=your_app_password_here
SMTP_FROM="BANTUG UNIVERSITY Admissions" <admissions@bantug.edu.example>

# University Contact Details for Inquiries
HELP_DESK_EMAIL=helpdesk@bantug.edu.example
HELP_DESK_PHONE=+63 917 555 0100

# Initial Administrator Account Setup (Phase 8)
# If not configured, default username is 'admin' with initial password requiring first-login change.
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=ChangeMeAdmin2026!
ADMIN_INITIAL_EMAIL=admin@bantug.edu.example
ADMIN_INITIAL_NAME=System Administrator


